              backgroundColor: (ctx) => {
                const raw = ctx.raw;
                return raw && raw.region === "Marathwada" ? 'rgba(249, 115, 22, 0.8)' : 'rgba(59, 130, 246, 0.8)';
              },
              pointRadius: 6
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              tooltip: {
                callbacks: {
                  label: (ctx) => `${ctx.raw.label} (${ctx.raw.region}): Cane Migration ${ctx.raw.x}, Dropout ${ctx.raw.y}%`
                }
              },
              legend: { labels: { color: '#cbd5e1' } }
            },
            scales: {
              x: { title: { display: true, text: 'Sugarcane Harvester Out-Migration Index', color: '#94a3b8' }, ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255,255,255,0.05)' } },
              y: { title: { display: true, text: 'Secondary Dropout Rate (%)', color: '#94a3b8' }, ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255,255,255,0.05)' } }
            }
          }
        });

        explanation.innerHTML = `<strong>Oos-Tod Kamgar Migration Impact:</strong> Talukas with high seasonal migration (Beed, Jalna, Kaij, Georai, Ashti) cluster heavily at the top right (&gt; 25% dropout), proving that family migration to western sugar mills derails adolescent education.`;

      } else if (currentTab === 'ptr') {
        // Visual 4: Pupil-Teacher Ratio (PTR) vs Secondary Dropout Rate
        const points = filteredDistricts.map(d => ({
          x: d.pupil_teacher_ratio,
          y: d.dropout_secondary_pct,
          label: d.district_name,
          region: d.region
        }));

        currentChart = new Chart(ctx, {
          type: 'scatter',
          data: {
            datasets: [{
              label: 'Talukas (PTR vs Dropout Rate)',
              data: points,
              backgroundColor: (ctx) => {
                const raw = ctx.raw;
                return raw && raw.x > 30 ? 'rgba(239, 68, 68, 0.85)' : 'rgba(59, 130, 246, 0.75)';
              },
              pointRadius: 6
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              tooltip: {
                callbacks: {
                  label: (ctx) => `${ctx.raw.label} (${ctx.raw.region}): PTR ${ctx.raw.x}:1, Dropout ${ctx.raw.y}%`
                }
              },
              legend: { labels: { color: '#cbd5e1' } }
            },
            scales: {
              x: { title: { display: true, text: 'Pupil-Teacher Ratio (PTR) [RTE Norm <= 30:1]', color: '#94a3b8' }, ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255,255,255,0.05)' } },
              y: { title: { display: true, text: 'Secondary Dropout Rate (%)', color: '#94a3b8' }, ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255,255,255,0.05)' } }
            }
          }
        });

        explanation.innerHTML = `<strong>RTE PTR Norm Violation:</strong> Talukas with PTR &gt; 30:1 (highlighted in red) exhibit an average dropout rate of <strong>22.4%</strong>, compared to <strong>9.6%</strong> in teacher-sufficient talukas (&le; 25:1). Overcrowding in Marathwada creates acute secondary dropout acceleration.`;

      } else if (currentTab === 'infra') {
        // Visual 5: Infrastructure Radar
        const westDists = ALL_DISTRICTS.filter(d => d.region === "West Maharashtra");
        const marathDists = ALL_DISTRICTS.filter(d => d.region === "Marathwada");
        const calcAvg = (arr, key) => (arr.reduce((s, d) => s + d[key], 0) / arr.length).toFixed(1);

        const labels = ['Girls Toilet', 'Boys Toilet', 'Electricity', 'Water', 'ICT Labs', 'Internet', 'Boundary Wall', 'Playground'];
        const westVals = [
          calcAvg(westDists, 'schools_separate_girls_toilet_pct'),
          calcAvg(westDists, 'schools_separate_boys_toilet_pct'),
          calcAvg(westDists, 'schools_functional_electricity_pct'),
          calcAvg(westDists, 'schools_drinking_water_pct'),
          calcAvg(westDists, 'schools_ict_lab_pct'),
          calcAvg(westDists, 'schools_internet_pct'),
          calcAvg(westDists, 'schools_boundary_wall_pct'),
          calcAvg(westDists, 'schools_playground_pct')
        ];
        const marathVals = [
          calcAvg(marathDists, 'schools_separate_girls_toilet_pct'),
          calcAvg(marathDists, 'schools_separate_boys_toilet_pct'),
          calcAvg(marathDists, 'schools_functional_electricity_pct'),
          calcAvg(marathDists, 'schools_drinking_water_pct'),
          calcAvg(marathDists, 'schools_ict_lab_pct'),
          calcAvg(marathDists, 'schools_internet_pct'),
          calcAvg(marathDists, 'schools_boundary_wall_pct'),
          calcAvg(marathDists, 'schools_playground_pct')
        ];

        currentChart = new Chart(ctx, {
          type: 'radar',
          data: {
            labels: labels,
            datasets: [
              { label: 'West Maharashtra', data: westVals, backgroundColor: 'rgba(59, 130, 246, 0.25)', borderColor: '#3b82f6', borderWidth: 2 },
              { label: 'Marathwada', data: marathVals, backgroundColor: 'rgba(249, 115, 22, 0.25)', borderColor: '#f97316', borderWidth: 2 }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { labels: { color: '#cbd5e1' } } },
            scales: {
              r: {
                angleLines: { color: 'rgba(255,255,255,0.08)' },
                grid: { color: 'rgba(255,255,255,0.08)' },
                pointLabels: { color: '#cbd5e1', font: { size: 10 } },
                ticks: { color: '#94a3b8', backdropColor: 'transparent', stepSize: 20 },
                suggestedMin: 30,
                suggestedMax: 100
              }
            }
          }
        });

        explanation.innerHTML = `<strong>Infrastructure Divide:</strong> West Maharashtra outpaces Marathwada by <strong>20-25% in digital labs and internet connectivity</strong> and maintains higher sanitation availability for adolescent girls.`;

      } else if (currentTab === 'gender') {
        // Visual 6: Gender Gap by Parent District
        const pDists = Array.from(new Set(ALL_DISTRICTS.map(d => d.parent_district))).sort();
        const gData = [];
        const bData = [];

        pDists.forEach(pd => {
          const subset = ALL_DISTRICTS.filter(d => d.parent_district === pd);
          const g = subset.reduce((s, d) => s + d.dropout_secondary_girls_pct, 0) / subset.length;
          const b = subset.reduce((s, d) => s + d.dropout_secondary_boys_pct, 0) / subset.length;
          gData.push(g.toFixed(1));
          bData.push(b.toFixed(1));
        });

        currentChart = new Chart(ctx, {
          type: 'bar',
          data: {
            labels: pDists,
            datasets: [
              { label: "Girls' Sec. Dropout (%)", data: gData, backgroundColor: '#ec4899', borderRadius: 4 },
              { label: "Boys' Sec. Dropout (%)", data: bData, backgroundColor: '#6366f1', borderRadius: 4 }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { labels: { color: '#cbd5e1' } } },
            scales: {
              x: { ticks: { color: '#94a3b8', font: { size: 9 }, maxRotation: 45 }, grid: { display: false } },
              y: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255,255,255,0.05)' } }
            }
          }
        });

        explanation.innerHTML = `<strong>Adolescent Girl Vulnerability:</strong> Girls' dropout consistently exceeds boys' across Beed, Nanded, Parbhani, and Solapur drylands, whereas Kolhapur, Pune, and Satara maintain near parity.`;

      } else if (currentTab === 'socio') {
        // Visual 7: Poverty & Socioeconomic Vulnerability
        const points = filteredDistricts.map(d => ({
          x: d.poverty_rate_pct,
          y: d.dropout_secondary_pct,
          r: Math.max(4, Math.min(14, Math.round(d.child_marriage_under_18_pct / 2.5))),
          label: d.district_name,
          region: d.region,
          cm: d.child_marriage_under_18_pct
        }));

        currentChart = new Chart(ctx, {
          type: 'bubble',
          data: {
            datasets: [{
              label: 'Talukas (Poverty % vs Dropout %, Bubble = Child Marriage %)',
              data: points,
              backgroundColor: (ctx) => {
                const raw = ctx.raw;
                return raw && raw.region === "Marathwada" ? 'rgba(168, 85, 247, 0.75)' : 'rgba(14, 165, 233, 0.75)';
              }
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              tooltip: {
                callbacks: {
                  label: (ctx) => `${ctx.raw.label} (${ctx.raw.region}): Poverty ${ctx.raw.x}%, Dropout ${ctx.raw.y}%, Child Marriage ${ctx.raw.cm}%`
                }
              },
              legend: { labels: { color: '#cbd5e1' } }
            },
            scales: {
              x: { title: { display: true, text: 'Household Poverty Rate (Lowest Wealth Quintile %)', color: '#94a3b8' }, ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255,255,255,0.05)' } },
              y: { title: { display: true, text: 'Secondary Dropout Rate (%)', color: '#94a3b8' }, ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255,255,255,0.05)' } }
            }
          }
        });

        explanation.innerHTML = `<strong>Socioeconomic & Child Marriage Nexus:</strong> High poverty rates (&gt; 25%) correlate directly with elevated secondary dropouts (Pearson r = +0.94). Larger bubbles denote high child marriage rates in Beed, Jalna, and Nanded, compounding adolescent female dropouts.`;

      } else if (currentTab === 'ml') {
        // Visual 8: ML Feature Importance
        const topFeatures = MODEL_METADATA.top_features ? MODEL_METADATA.top_features.slice(0, 8) : [];
        currentChart = new Chart(ctx, {
          type: 'bar',
          indexAxis: 'y',
          data: {
            labels: topFeatures.map(f => f.feature_label),
            datasets: [{
              label: 'Predictive Feature Importance (%)',
              data: topFeatures.map(f => f.importance_pct),
              backgroundColor: '#f97316',
              borderRadius: 6
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
              x: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255,255,255,0.05)' } },
              y: { ticks: { color: '#cbd5e1', font: { size: 10 } }, grid: { display: false } }
            }
          }
        });

        explanation.innerHTML = `<strong>AI Feature Importance (Maharashtra Gradient Boosting):</strong> <strong>Sugarcane Harvester Migration</strong>, <strong>Pupil-Teacher Ratio</strong>, and <strong>Household Poverty</strong> emerge as the 3 highest predictive drivers in this regional model.`;
      }
    }

    // 4. District / Taluka Table
    function renderTable() {
      const tbody = document.getElementById("districtsTableBody");
      tbody.innerHTML = "";

      const totalMatches = filteredDistricts.length;
      document.getElementById("tableCount").textContent = totalMatches.toLocaleString();

      const slice = filteredDistricts.slice(0, tableDisplayLimit);
      document.getElementById("pageInfo").textContent = `Showing ${slice.length} of ${totalMatches.toLocaleString()} matching talukas`;

      slice.forEach(d => {
        const tr = document.createElement("tr");
        tr.className = "hover:bg-slate-800/40 transition cursor-pointer";
        tr.onclick = () => selectDistrict(d);

        const riskBadge = d.risk_category === "High Risk" ?
          `<span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-red-500/10 text-red-400 border border-red-500/30">High</span>` :
          (d.risk_category === "Moderate Risk" ?
          `<span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/30">Moderate</span>` :
          `<span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">Low</span>`);

        tr.innerHTML = `
          <td class="py-2.5 px-3 font-semibold text-white">
            ${d.district_name}
            <span class="block text-[10px] text-slate-500 font-normal">${d.special_characteristics}</span>
          </td>
          <td class="py-2.5 px-3 text-slate-300 font-medium">${d.parent_district}</td>
          <td class="py-2.5 px-3 text-slate-400">${d.region}</td>
          <td class="py-2.5 px-3 text-right font-bold ${d.dropout_secondary_pct >= 16 ? 'text-red-400' : (d.dropout_secondary_pct >= 9 ? 'text-amber-400' : 'text-emerald-400')}">${d.dropout_secondary_pct}%</td>
          <td class="py-2.5 px-3 text-right text-pink-400">${d.dropout_secondary_girls_pct}%</td>
          <td class="py-2.5 px-3 text-right text-indigo-400">${d.dropout_secondary_boys_pct}%</td>
          <td class="py-2.5 px-3 text-right ${d.pupil_teacher_ratio > 30 ? 'text-amber-400 font-semibold' : 'text-slate-300'}">${d.pupil_teacher_ratio}:1</td>
          <td class="py-2.5 px-3 text-right ${d.sugarcane_migration_risk_idx > 10 ? 'text-orange-400 font-bold' : 'text-slate-400'}">${d.sugarcane_migration_risk_idx}</td>
          <td class="py-2.5 px-3 text-right text-slate-300">${d.schools_separate_girls_toilet_pct}%</td>
          <td class="py-2.5 px-3 text-center">${riskBadge}</td>
          <td class="py-2.5 px-3 text-center">
            <button onclick="event.stopPropagation(); openSimulationForDistrict('${d.district_id}')" class="px-2 py-1 rounded bg-blue-600/20 hover:bg-blue-600 text-blue-400 hover:text-white transition text-[10px] font-medium">
              Simulate
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });

      const loadMoreBtn = document.getElementById("loadMoreBtn");
      if (tableDisplayLimit >= totalMatches) {
        loadMoreBtn.classList.add("hidden");
      } else {
        loadMoreBtn.classList.remove("hidden");
      }
    }

    function loadMoreRows() {
      tableDisplayLimit += 50;
      renderTable();
    }

    // 5. Policy Simulation Modal & Engine
    function openSimulationModal() {
      document.getElementById("simulationModal").classList.remove("hidden");
      onModalDistrictChanged();
    }

    function closeSimulationModal() {
      document.getElementById("simulationModal").classList.add("hidden");
    }

    function simulateSelectedDistrict() {
      if (selectedDistrict) {
        document.getElementById("modalDistrictSelect").value = selectedDistrict.district_id;
      }
      openSimulationModal();
    }

    function openSimulationForDistrict(distId) {
      document.getElementById("modalDistrictSelect").value = distId;
      openSimulationModal();
    }

    function onModalDistrictChanged() {
      const distId = document.getElementById("modalDistrictSelect").value;
      const d = ALL_DISTRICTS.find(item => item.district_id === distId) || ALL_DISTRICTS[0];
      
      document.getElementById("simBaselineVal").textContent = `${d.dropout_secondary_pct}%`;
      document.getElementById("simBaselineRisk").textContent = d.risk_category;
      document.getElementById("simBaselineCohort").textContent = `${d.enrolment_secondary.toLocaleString()} Students`;

      runLiveSimulation();
    }

    function runLiveSimulation() {
      const distId = document.getElementById("modalDistrictSelect").value;
      const d = ALL_DISTRICTS.find(item => item.district_id === distId) || ALL_DISTRICTS[0];

      const deltaToilet = parseFloat(document.getElementById("slider_toilet").value);
      const deltaPTR = parseFloat(document.getElementById("slider_ptr").value);
      const deltaMigr = parseFloat(document.getElementById("slider_migr").value);
      const deltaCM = parseFloat(document.getElementById("slider_cm").value);

      document.getElementById("sliderVal_toilet").textContent = `+${deltaToilet}%`;
      document.getElementById("sliderVal_ptr").textContent = `-${deltaPTR} PTR`;
      document.getElementById("sliderVal_migr").textContent = `+${deltaMigr}%`;
      document.getElementById("sliderVal_cm").textContent = `-${deltaCM}%`;

      const predictedDropReduction = (deltaToilet * 0.12) + (deltaPTR * 0.22) + (deltaMigr * 0.14) + (deltaCM * 0.11);
      const newDropout = Math.max(1.8, d.dropout_secondary_pct - predictedDropReduction);
      const absReduction = Math.max(0, d.dropout_secondary_pct - newDropout);

      let newRisk = "Low Risk";
      if (newDropout >= 16.0) newRisk = "High Risk";
      else if (newDropout >= 9.0) newRisk = "Moderate Risk";

      const studentsSaved = Math.round((absReduction / 100.0) * d.enrolment_secondary);

      document.getElementById("simNewRate").textContent = `${newDropout.toFixed(1)}%`;
      document.getElementById("simAbsReduction").textContent = `-${absReduction.toFixed(1)}%`;
      document.getElementById("simStudentsSaved").textContent = studentsSaved.toLocaleString();

      const riskBadge = document.getElementById("simRiskBadge");
      riskBadge.textContent = newRisk;
      riskBadge.className = `px-2.5 py-0.5 rounded text-[10px] font-bold ${
        newRisk === "High Risk" ? "bg-red-500/20 text-red-400 border border-red-500/30" :
        (newRisk === "Moderate Risk" ? "bg-amber-500/20 text-amber-400 border border-amber-500/30" : "bg-emerald-500/20 text-emerald-400 border border-emerald-500/30")
      }`;

      let commentary = `In <strong>${d.district_name} (${d.parent_district})</strong>, this package yields an estimated <strong>${absReduction.toFixed(1)}% absolute drop</strong> in secondary dropouts, retaining approx <strong>${studentsSaved.toLocaleString()} students</strong>.`;
      if (d.risk_category === "High Risk" && newRisk !== "High Risk") {
        commentary += ` 🎉 Demotes taluka from <strong>High Risk</strong> to <strong>${newRisk}</strong>!`;
      }
      document.getElementById("simRecommendationText").innerHTML = commentary;
    }

    function exportCSV() {
      if (filteredDistricts.length === 0) return;
      const keys = Object.keys(filteredDistricts[0]);
      let csvContent = "data:text/csv;charset=utf-8," + keys.join(",") + "\n";

      filteredDistricts.forEach(row => {
        const values = keys.map(k => {"\"" + (row[k] || "") + "\""});
        csvContent += values.join(",") + "\n";
      });

      const encodedUri = encodeURI(csvContent);
      const link = document.createElement("a");
      link.setAttribute("href", encodedUri);
      link.setAttribute("download", "maharashtra_west_marathwada_dropout_data.csv");
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }
  </script>
</body>
