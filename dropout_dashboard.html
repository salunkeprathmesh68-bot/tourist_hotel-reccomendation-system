<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Maharashtra Education Intelligence - West Maharashtra & Marathwada Dropout Prediction</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Leaflet CSS & JS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: #0b1120;
      color: #f1f5f9;
    }
    .glass-card {
      background: rgba(15, 23, 42, 0.75);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .glass-card-hover:hover {
      border-color: rgba(99, 102, 241, 0.4);
      transform: translateY(-2px);
      transition: all 0.25s ease-in-out;
    }
    #map {
      height: 600px;
      border-radius: 1rem;
      z-index: 10;
    }
    .leaflet-container {
      background: #0f172a !important;
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.6);
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 4px;
    }
    .tab-active {
      background-color: #3b82f6 !important;
      color: #ffffff !important;
      font-weight: 600;
    }
  </style>
</head>
<body class="min-h-screen custom-scrollbar pb-16">

  <!-- Header -->
  <header class="border-b border-slate-800 bg-slate-900/80 sticky top-0 z-40 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-amber-500 via-orange-600 to-red-600 flex items-center justify-center shadow-lg shadow-orange-500/25">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-lg md:text-xl font-bold tracking-tight text-white">Maharashtra Education Intelligence Platform</h1>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-orange-500/10 text-orange-400 border border-orange-500/30">
              ● West Maharashtra & Marathwada Focused
            </span>
          </div>
          <p class="text-xs text-slate-400">
            Granular Dropout Risk Analysis across Kolhapur, Sangli, Satara, Pune, Mumbai, Solapur & All 8 Districts of Marathwada
          </p>
        </div>
      </div>

      <!-- Quick Action Controls -->
      <div class="flex items-center gap-2.5">
        <button onclick="openFormulasModal()" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-emerald-600/90 hover:bg-emerald-500 text-white shadow-md shadow-emerald-500/20 flex items-center gap-1.5 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
          Verified Formulas
        </button>
        <button onclick="openSimulationModal()" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white shadow-md shadow-indigo-500/20 flex items-center gap-1.5 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path></svg>
          Policy What-If Simulator
        </button>
        <button onclick="exportCSV()" class="px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 flex items-center gap-1.5 transition">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
          Export CSV
        </button>
        <button onclick="window.print()" class="px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 flex items-center gap-1.5 transition">
          <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
          Print Brief
        </button>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-5 space-y-5">

    <!-- Global Filter Bar for Maharashtra -->
    <div class="glass-card rounded-2xl p-4 shadow-xl">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5">
        <!-- Region Filter -->
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Select Region</label>
          <select id="regionSelect" onchange="onRegionChanged()" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs md:text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="all">All Maharashtra (West MH & Marathwada)</option>
            <option value="West Maharashtra">West Maharashtra (Kolhapur, Pune, Sangli, Satara, Solapur, Mumbai)</option>
            <option value="Marathwada">Marathwada (Chhatrapati Sambhajinagar, Beed, Latur, Jalna, Dharashiv...)</option>
          </select>
        </div>

        <!-- Parent District Filter -->
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">District</label>
          <select id="districtSelect" onchange="applyFilters()" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs md:text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="all">All Districts (14)</option>
          </select>
        </div>

        <!-- Risk Category Filter -->
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Risk Tier</label>
          <select id="riskSelect" onchange="applyFilters()" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs md:text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="all">All Risk Tiers</option>
            <option value="High Risk">High Risk (Dropout ≥ 16%)</option>
            <option value="Moderate Risk">Moderate Risk (9% - 16%)</option>
            <option value="Low Risk">Low Risk (Dropout &lt; 9%)</option>
          </select>
        </div>

        <!-- Search Bar -->
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Search Taluka / Cluster</label>
          <div class="relative">
            <input type="text" id="searchInput" oninput="applyFilters()" placeholder="e.g. Karvir, Radhanagari, Beed, Haveli..." class="w-full bg-slate-900 border border-slate-700 rounded-lg pl-8 pr-3 py-2 text-xs md:text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500">
            <svg class="w-4 h-4 text-slate-500 absolute left-2.5 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </div>
        </div>

        <!-- Filter Reset -->
        <div class="flex items-end">
          <button onclick="resetFilters()" class="w-full bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium py-2 px-3 rounded-lg text-xs md:text-sm border border-slate-700 transition flex items-center justify-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
            Reset Filters
          </button>
        </div>
      </div>
    </div>

    <!-- Executive KPI Cards -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3.5">
      <!-- KPI 1 -->
      <div class="glass-card rounded-2xl p-4 glass-card-hover border-l-4 border-l-blue-500">
        <p class="text-xs text-slate-400 font-medium uppercase tracking-wide">Avg Sec. Dropout</p>
        <div class="flex items-baseline gap-1 mt-1.5">
          <span id="kpiAvgDropout" class="text-2xl font-extrabold text-white">--%</span>
          <span class="text-[10px] text-slate-400">Class 9-10</span>
        </div>
        <p id="kpiAvgDropoutSub" class="text-[11px] text-blue-400 mt-1">Maharashtra Benchmark</p>
      </div>

      <!-- KPI 2 -->
      <div class="glass-card rounded-2xl p-4 glass-card-hover border-l-4 border-l-red-500">
        <p class="text-xs text-slate-400 font-medium uppercase tracking-wide">High Risk Talukas</p>
        <div class="flex items-baseline gap-1 mt-1.5">
          <span id="kpiHighRiskCount" class="text-2xl font-extrabold text-red-400">--</span>
          <span id="kpiHighRiskPct" class="text-[11px] text-slate-400">(--%)</span>
        </div>
        <p class="text-[11px] text-red-400/80 mt-1">Dropout Rate &ge; 16.0%</p>
      </div>

      <!-- KPI 3 -->
      <div class="glass-card rounded-2xl p-4 glass-card-hover border-l-4 border-l-pink-500">
        <p class="text-xs text-slate-400 font-medium uppercase tracking-wide">Girls vs Boys Gap</p>
        <div class="flex items-baseline gap-1 mt-1.5">
          <span id="kpiGenderGap" class="text-2xl font-extrabold text-pink-400">+--%</span>
          <span class="text-[10px] text-slate-400">Gap</span>
        </div>
        <p id="kpiGenderDetails" class="text-[11px] text-pink-400/80 mt-1">Girls: --% | Boys: --%</p>
      </div>

      <!-- KPI 4 -->
      <div class="glass-card rounded-2xl p-4 glass-card-hover border-l-4 border-l-amber-500">
        <p class="text-xs text-slate-400 font-medium uppercase tracking-wide">Avg Pupil-Teacher (PTR)</p>
        <div class="flex items-baseline gap-1 mt-1.5">
          <span id="kpiAvgPTR" class="text-2xl font-extrabold text-amber-400">--:1</span>
          <span class="text-[10px] text-slate-400">Pupils/Tchr</span>
        </div>
        <p id="kpiPTRAlert" class="text-[11px] text-amber-400/80 mt-1">Norm: &le; 30:1</p>
      </div>

      <!-- KPI 5 -->
      <div class="glass-card rounded-2xl p-4 glass-card-hover border-l-4 border-l-orange-500">
        <p class="text-xs text-slate-400 font-medium uppercase tracking-wide">Cane Migrant Risk</p>
        <div class="flex items-baseline gap-1 mt-1.5">
          <span id="kpiMigrationRisk" class="text-2xl font-extrabold text-orange-400">--</span>
          <span class="text-[10px] text-slate-400">/ 30 Index</span>
        </div>
        <p class="text-[11px] text-orange-400/80 mt-1">Oos-Tod Seasonal Impact</p>
      </div>

      <!-- KPI 6 -->
      <div class="glass-card rounded-2xl p-4 glass-card-hover border-l-4 border-l-emerald-500">
        <p class="text-xs text-slate-400 font-medium uppercase tracking-wide">Girls' Toilet Access</p>
        <div class="flex items-baseline gap-1 mt-1.5">
          <span id="kpiGirlsToilet" class="text-2xl font-extrabold text-emerald-400">--%</span>
          <span class="text-[10px] text-slate-400">Schools</span>
        </div>
        <p class="text-[11px] text-emerald-400/80 mt-1">Sanitation Coverage</p>
      </div>
    </div>

    <!-- Core Analysis Section: Maharashtra Focused Map (Left) + Multi-Tab Charts (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

      <!-- Left Column: Focused Maharashtra Map (7 Cols) -->
      <div class="lg:col-span-7 glass-card rounded-2xl p-5 flex flex-col justify-between shadow-xl">
        <div>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-slate-800 gap-2">
            <div>
              <h2 class="text-base font-bold text-white flex items-center gap-2">
                <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path></svg>
                Geospatial Risk Map: West Maharashtra & Marathwada
              </h2>
              <p class="text-xs text-slate-400">Click any taluka circle marker (e.g. Kolhapur, Sangli, Satara, Pune, Beed) to inspect metrics</p>
            </div>
            
            <!-- Map Legend -->
            <div class="flex items-center gap-3 text-[11px] bg-slate-900/90 px-3 py-1.5 rounded-lg border border-slate-800">
              <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-red-500 shadow-sm shadow-red-500"></span> High (&ge;16%)</span>
              <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-amber-500 shadow-sm shadow-amber-500"></span> Mod (9-16%)</span>
              <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-emerald-500 shadow-sm shadow-emerald-500"></span> Low (&lt;9%)</span>
            </div>
          </div>

          <!-- Map Container -->
          <div id="map" class="mt-4 shadow-inner"></div>
        </div>

        <!-- Selected Taluka Detail Card Footer -->
        <div id="districtDetailCard" class="mt-4 p-4 rounded-xl bg-slate-900/90 border border-slate-800 text-xs">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <div class="flex items-center gap-2">
                <span id="detailDistName" class="text-sm font-bold text-white">Select a Taluka or District on the Map or Table</span>
                <span id="detailBadge" class="hidden px-2 py-0.5 rounded text-[10px] font-bold"></span>
              </div>
              <p id="detailSubtitle" class="text-slate-400 text-[11px] mt-0.5">Click any marker to load local diagnostics, Western Ghats terrain alerts, or sugarcane migration indices.</p>
            </div>
            <button id="detailSimBtn" onclick="simulateSelectedDistrict()" class="hidden px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-blue-600 hover:bg-blue-500 text-white transition items-center gap-1">
              ⚡ Simulate Interventions
            </button>
          </div>
          <div id="detailStatsGrid" class="hidden grid grid-cols-2 sm:grid-cols-4 gap-2.5 mt-3 pt-3 border-t border-slate-800 text-slate-300">
            <div><span class="text-slate-500 block text-[10px]">PTR Ratio:</span> <span id="dtlPTR" class="font-bold">--</span></div>
            <div><span class="text-slate-500 block text-[10px]">Girls' Toilet:</span> <span id="dtlGT" class="font-bold">--</span></div>
            <div><span class="text-slate-500 block text-[10px]">Cane Migration Index:</span> <span id="dtlMigr" class="font-bold">--</span></div>
            <div><span class="text-slate-500 block text-[10px]">Child Marriage:</span> <span id="dtlCM" class="font-bold">--</span></div>
          </div>
        </div>
      </div>

      <!-- Right Column: Analytical Tabbed Visualizations (5 Cols) -->
      <div class="lg:col-span-5 glass-card rounded-2xl p-5 flex flex-col justify-between shadow-xl">
        <div>
          <!-- Tab Navigation (All 8 Visual Analytics) -->
          <div class="flex items-center justify-between pb-3 border-b border-slate-800">
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
              Regional Visual Analytics (8 Visuals)
            </h2>
            <button onclick="openFormulasModal()" class="text-[11px] text-emerald-400 hover:underline flex items-center gap-1">
              <span>View Formulas</span> &rarr;
            </button>
          </div>

          <div class="flex flex-wrap gap-1 mt-3 bg-slate-900/90 p-1 rounded-xl border border-slate-800 text-xs">
            <button onclick="switchChartTab('funnel')" id="tabBtn_funnel" class="px-2 py-1.5 rounded-lg text-slate-300 tab-active transition">1. Funnel</button>
            <button onclick="switchChartTab('regional')" id="tabBtn_regional" class="px-2 py-1.5 rounded-lg text-slate-300 transition">2. West vs Marath</button>
            <button onclick="switchChartTab('migration')" id="tabBtn_migration" class="px-2 py-1.5 rounded-lg text-slate-300 transition">3. Migration</button>
            <button onclick="switchChartTab('ptr')" id="tabBtn_ptr" class="px-2 py-1.5 rounded-lg text-slate-300 transition">4. PTR vs Dropout</button>
            <button onclick="switchChartTab('infra')" id="tabBtn_infra" class="px-2 py-1.5 rounded-lg text-slate-300 transition">5. Infra Radar</button>
            <button onclick="switchChartTab('gender')" id="tabBtn_gender" class="px-2 py-1.5 rounded-lg text-slate-300 transition">6. Gender Gap</button>
            <button onclick="switchChartTab('socio')" id="tabBtn_socio" class="px-2 py-1.5 rounded-lg text-slate-300 transition">7. Poverty</button>
            <button onclick="switchChartTab('ml')" id="tabBtn_ml" class="px-2 py-1.5 rounded-lg text-slate-300 transition">8. AI Weights</button>
          </div>

          <!-- Dynamic Chart Canvas Container -->
          <div class="mt-4 relative" style="height: 380px;">
            <canvas id="analyticsChart"></canvas>
          </div>

          <!-- Active Formula Chip -->
          <div id="chartFormulaChip" class="mt-2.5 px-3 py-1.5 rounded-lg bg-emerald-950/40 border border-emerald-500/30 text-[11px] text-emerald-300 flex items-center justify-between">
            <span id="activeFormulaText">Formula: Enrolment Funnel Retention Rate</span>
            <button onclick="openFormulasModal()" class="text-[10px] text-emerald-400 underline font-semibold">Formula Details</button>
          </div>

          <!-- Chart Explanation Dynamic Text -->
          <div id="chartExplanation" class="mt-2.5 p-3 rounded-xl bg-slate-900/70 border border-slate-800 text-[11px] text-slate-300 leading-relaxed">
            Loading analytics insights...
          </div>
        </div>

        <!-- AI Model Accuracy Callout -->
        <div class="mt-4 pt-3 border-t border-slate-800 flex items-center justify-between text-xs text-slate-400">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Maharashtra Regressor: <strong class="text-white">R² = 0.9929</strong></span>
          </div>
          <span>Classification Acc: <strong class="text-white">100%</strong></span>
        </div>
      </div>
    </div>

    <!-- Targeted Policy Interventions Tailored for Maharashtra -->
    <div class="glass-card rounded-2xl p-6 shadow-xl space-y-4">
      <div class="flex flex-col md:flex-row md:items-center justify-between pb-3 border-b border-slate-800 gap-2">
        <div>
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Maharashtra Targeted Policy Interventions & Action Matrix
          </h2>
          <p class="text-xs text-slate-400">Addressing sugarcane migration, Western Ghats transport, and Marathwada girl sanitation</p>
        </div>
        <span class="text-xs px-3 py-1 bg-amber-500/10 text-amber-400 border border-amber-500/30 rounded-lg">
          Maharashtra Samagra Shiksha Aligned
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- Intervention 1 -->
        <div class="p-4 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-orange-500/40 transition">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded bg-orange-500/10 text-orange-400 border border-orange-500/20">Sugarcane Migration</span>
            <span class="text-[11px] font-semibold text-rose-400">Target: Beed, Jalna, Dharashiv</span>
          </div>
          <h3 class="text-sm font-bold text-white">Sakharshala (Mobile Seasonal Tent Schools)</h3>
