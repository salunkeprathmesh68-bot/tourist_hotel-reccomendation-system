    document.addEventListener("DOMContentLoaded", () => {
      initFilterDropdowns();
      initLeafletMap();
      renderDashboard();
    });

    function openFormulasModal() {
      document.getElementById("formulasModal").classList.remove("hidden");
    }

    function closeFormulasModal() {
      document.getElementById("formulasModal").classList.add("hidden");
    }

    function initFilterDropdowns() {
      const districtSelect = document.getElementById("districtSelect");
      const districts = Array.from(new Set(ALL_DISTRICTS.map(d => d.parent_district))).sort();
      districts.forEach(dst => {
        const opt = document.createElement("option");
        opt.value = dst;
        opt.textContent = dst;
        districtSelect.appendChild(opt);
      });

      const modalSelect = document.getElementById("modalDistrictSelect");
      ALL_DISTRICTS.forEach(d => {
        const opt = document.createElement("option");
        opt.value = d.district_id;
        opt.textContent = `${d.district_name} (${d.parent_district}) - ${d.dropout_secondary_pct}% Dropout [${d.risk_category}]`;
        modalSelect.appendChild(opt);
      });
    }

    function onRegionChanged() {
      const region = document.getElementById("regionSelect").value;
      const districtSelect = document.getElementById("districtSelect");
      districtSelect.innerHTML = '<option value="all">All Districts</option>';

      let candidateDistricts = ALL_DISTRICTS;
      if (region !== "all") {
        candidateDistricts = candidateDistricts.filter(d => d.region === region);
      }
      const districts = Array.from(new Set(candidateDistricts.map(d => d.parent_district))).sort();
      districts.forEach(dst => {
        const opt = document.createElement("option");
        opt.value = dst;
        opt.textContent = dst;
        districtSelect.appendChild(opt);
      });

      applyFilters();
    }

    function applyFilters() {
      const region = document.getElementById("regionSelect").value;
      const district = document.getElementById("districtSelect").value;
      const risk = document.getElementById("riskSelect").value;
      const search = document.getElementById("searchInput").value.toLowerCase().trim();

      filteredDistricts = ALL_DISTRICTS.filter(d => {
        if (region !== "all" && d.region !== region) return false;
        if (district !== "all" && d.parent_district !== district) return false;
        if (risk !== "all" && d.risk_category !== risk) return false;
        if (search) {
          const matchName = d.district_name.toLowerCase().includes(search);
          const matchParent = d.parent_district.toLowerCase().includes(search);
          const matchDesc = (d.special_characteristics || "").toLowerCase().includes(search);
          if (!matchName && !matchParent && !matchDesc) return false;
        }
        return true;
      });

      tableDisplayLimit = 50;
      renderDashboard();
    }

    function resetFilters() {
      document.getElementById("regionSelect").value = "all";
      onRegionChanged();
      document.getElementById("districtSelect").value = "all";
      document.getElementById("riskSelect").value = "all";
      document.getElementById("searchInput").value = "";
      applyFilters();
    }

    function renderDashboard() {
      updateKPIs();
      renderMapMarkers();
      renderActiveChart();
      renderTable();
    }

    // 1. KPI Calculation
    function updateKPIs() {
      if (filteredDistricts.length === 0) return;

      const total = filteredDistricts.length;
      const avgDrop = filteredDistricts.reduce((sum, d) => sum + d.dropout_secondary_pct, 0) / total;
      const highRiskCount = filteredDistricts.filter(d => d.risk_category === "High Risk").length;
      const highRiskPct = (highRiskCount / total) * 100;
      
      const avgGirlsDrop = filteredDistricts.reduce((sum, d) => sum + d.dropout_secondary_girls_pct, 0) / total;
      const avgBoysDrop = filteredDistricts.reduce((sum, d) => sum + d.dropout_secondary_boys_pct, 0) / total;
      const gap = avgGirlsDrop - avgBoysDrop;

      const avgPTR = filteredDistricts.reduce((sum, d) => sum + d.pupil_teacher_ratio, 0) / total;
      const avgMigr = filteredDistricts.reduce((sum, d) => sum + d.sugarcane_migration_risk_idx, 0) / total;
      const avgGT = filteredDistricts.reduce((sum, d) => sum + d.schools_separate_girls_toilet_pct, 0) / total;

      document.getElementById("kpiAvgDropout").textContent = `${avgDrop.toFixed(1)}%`;
      document.getElementById("kpiHighRiskCount").textContent = highRiskCount;
      document.getElementById("kpiHighRiskPct").textContent = `(${highRiskPct.toFixed(0)}%)`;
      
      document.getElementById("kpiGenderGap").textContent = `${gap >= 0 ? '+' : ''}${gap.toFixed(1)}%`;
      document.getElementById("kpiGenderDetails").textContent = `Girls: ${avgGirlsDrop.toFixed(1)}% | Boys: ${avgBoysDrop.toFixed(1)}%`;
      
      document.getElementById("kpiAvgPTR").textContent = `${avgPTR.toFixed(1)}:1`;
      document.getElementById("kpiMigrationRisk").textContent = avgMigr.toFixed(1);
      document.getElementById("kpiGirlsToilet").textContent = `${avgGT.toFixed(1)}%`;
    }

    // 2. Leaflet Map
    function initLeafletMap() {
      leafletMap = L.map('map', {
        center: [18.6, 75.1],
        zoom: 7.5,
        minZoom: 6,
        maxZoom: 12
      });

      L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; OpenStreetMap contributors &copy; CARTO',
        subdomains: 'abcd',
        maxZoom: 19
      }).addTo(leafletMap);

      markersLayer = L.layerGroup().addTo(leafletMap);
    }

    function renderMapMarkers() {
      markersLayer.clearLayers();

      filteredDistricts.forEach(d => {
        let color = '#10b981';
        let fillColor = '#10b981';
        if (d.risk_category === "High Risk") {
          color = '#ef4444';
          fillColor = '#ef4444';
        } else if (d.risk_category === "Moderate Risk") {
          color = '#f59e0b';
          fillColor = '#f59e0b';
        }

        const radius = Math.max(7, Math.min(22, d.dropout_secondary_pct * 0.9));

        const marker = L.circleMarker([d.latitude, d.longitude], {
          radius: radius,
          color: color,
          weight: 2,
          fillColor: fillColor,
          fillOpacity: 0.65
        });

        const popupContent = `
          <div class="text-slate-900 font-sans p-1">
            <div class="flex items-center justify-between gap-2 border-b border-slate-200 pb-1">
              <strong class="text-sm font-bold text-slate-900">${d.district_name}</strong>
              <span class="text-[10px] px-1.5 py-0.5 rounded font-bold ${
                d.risk_category === 'High Risk' ? 'bg-red-100 text-red-700' :
                (d.risk_category === 'Moderate Risk' ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700')
              }">${d.risk_category}</span>
            </div>
            <p class="text-[11px] text-slate-600 mt-1"><strong>Parent District:</strong> ${d.parent_district} (${d.region})</p>
            <div class="grid grid-cols-2 gap-1.5 my-2 text-[11px] bg-slate-50 p-2 rounded border border-slate-200">
              <div><span class="text-slate-500">Sec. Dropout:</span> <strong class="text-slate-900">${d.dropout_secondary_pct}%</strong></div>
              <div><span class="text-slate-500">Girls Dropout:</span> <strong class="text-pink-600">${d.dropout_secondary_girls_pct}%</strong></div>
              <div><span class="text-slate-500">PTR:</span> <strong class="text-slate-900">${d.pupil_teacher_ratio}:1</strong></div>
              <div><span class="text-slate-500">Cane Migr Index:</span> <strong class="text-orange-600">${d.sugarcane_migration_risk_idx}</strong></div>
            </div>
            <div class="flex gap-2 mt-2">
              <button onclick="selectDistrictById('${d.district_id}')" class="w-full text-center py-1 bg-slate-900 text-white rounded text-[11px] font-semibold hover:bg-slate-800 transition">
                Inspect Details
              </button>
              <button onclick="openSimulationForDistrict('${d.district_id}')" class="w-full text-center py-1 bg-blue-600 text-white rounded text-[11px] font-semibold hover:bg-blue-500 transition">
                Simulate
              </button>
            </div>
          </div>
        `;

        marker.bindPopup(popupContent);
        marker.on('click', () => {
          selectDistrict(d);
        });

        markersLayer.addLayer(marker);
      });

      // Auto-fit if specific district selected
      const district = document.getElementById("districtSelect").value;
      if (district !== "all" && filteredDistricts.length > 0) {
        const bounds = L.latLngBounds(filteredDistricts.map(d => [d.latitude, d.longitude]));
        leafletMap.fitBounds(bounds, { padding: [40, 40], maxZoom: 10 });
      } else if (document.getElementById("regionSelect").value === "West Maharashtra") {
        leafletMap.setView([17.8, 74.2], 8);
      } else if (document.getElementById("regionSelect").value === "Marathwada") {
        leafletMap.setView([19.2, 76.2], 8);
      } else {
        leafletMap.setView([18.6, 75.1], 7.5);
      }
    }

    function selectDistrict(d) {
      selectedDistrict = d;
      document.getElementById("detailDistName").textContent = `${d.district_name} (${d.parent_district})`;
      
      const badge = document.getElementById("detailBadge");
      badge.classList.remove("hidden");
      badge.textContent = `${d.dropout_secondary_pct}% Dropout (${d.risk_category})`;
      badge.className = `px-2 py-0.5 rounded text-[10px] font-bold ${
        d.risk_category === "High Risk" ? "bg-red-500/20 text-red-400 border border-red-500/30" :
        (d.risk_category === "Moderate Risk" ? "bg-amber-500/20 text-amber-400 border border-amber-500/30" : "bg-emerald-500/20 text-emerald-400 border border-emerald-500/30")
      }`;

      document.getElementById("detailSubtitle").textContent = `${d.region} | ${d.special_characteristics} | Vulnerability Score: ${d.vulnerability_score}/100`;
      
      document.getElementById("detailStatsGrid").classList.remove("hidden");
      document.getElementById("dtlPTR").textContent = `${d.pupil_teacher_ratio}:1 (${d.pupil_teacher_ratio > 30 ? "High PTR" : "Normal"})`;
      document.getElementById("dtlGT").textContent = `${d.schools_separate_girls_toilet_pct}%`;
      document.getElementById("dtlMigr").textContent = `${d.sugarcane_migration_risk_idx} / 30`;
      document.getElementById("dtlCM").textContent = `${d.child_marriage_under_18_pct}%`;

      const simBtn = document.getElementById("detailSimBtn");
      simBtn.classList.remove("hidden");
      simBtn.classList.add("flex");

      leafletMap.setView([d.latitude, d.longitude], 9, { animate: true });
    }

    function selectDistrictById(distId) {
      const d = ALL_DISTRICTS.find(item => item.district_id === distId);
      if (d) selectDistrict(d);
    }

    // 3. Tabbed Charts for Maharashtra (All 8 Visuals)
    function switchChartTab(tabKey) {
      currentTab = tabKey;
      ['funnel', 'regional', 'migration', 'ptr', 'infra', 'gender', 'socio', 'ml'].forEach(t => {
        const btn = document.getElementById(`tabBtn_${t}`);
        if (btn) {
          if (t === tabKey) btn.classList.add('tab-active');
          else btn.classList.remove('tab-active');
        }
      });
      
      const formulaChip = document.getElementById("activeFormulaText");
      if (formulaChip && FORMULA_TEXTS[tabKey]) {
        formulaChip.textContent = FORMULA_TEXTS[tabKey];
      }

      renderActiveChart();
