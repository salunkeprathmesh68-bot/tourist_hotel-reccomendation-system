    // Text To Speech
    function toggleSpeech() {
        if (state.speaking) {
            stopSpeech();
        } else {
            if (!state.activeNewsItem) return;
            const textToSpeak = `${state.activeNewsItem.title_mr}. ${state.activeNewsItem.content_mr || state.activeNewsItem.summary_mr}. अधिकृत स्त्रोत: ${state.activeNewsItem.source_name}`;
            speakText(textToSpeak);
        }
    }

    function speakText(text) {
        if (!('speechSynthesis' in window)) {
            alert('आपल्या ब्राउझरमध्ये व्हॉइस स्पीच उपलब्ध नाही.');
            return;
        }

        window.speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'mr-IN';
        utterance.rate = 0.95;

        // Try to pick Marathi or Indian voice if available
        const voices = window.speechSynthesis.getVoices();
        const mrVoice = voices.find(v => v.lang.includes('mr') || v.lang.includes('hi') || v.name.includes('India'));
        if (mrVoice) utterance.voice = mrVoice;

        utterance.onstart = () => {
            state.speaking = true;
            if (elements.ttsBtnLabel) elements.ttsBtnLabel.textContent = 'थांबवा (Pause)';
        };

        utterance.onend = () => {
            state.speaking = false;
            if (elements.ttsBtnLabel) elements.ttsBtnLabel.textContent = 'मराठीत बातमी ऐका';
        };

        utterance.onerror = () => {
            state.speaking = false;
            if (elements.ttsBtnLabel) elements.ttsBtnLabel.textContent = 'मराठीत बातमी ऐका';
        };

        window.speechSynthesis.speak(utterance);
    }

    function stopSpeech() {
        if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel();
        }
        state.speaking = false;
        if (elements.ttsBtnLabel) elements.ttsBtnLabel.textContent = 'मराठीत बातमी ऐका';
    }

    // WhatsApp Share Pre-Formatted Message
    function shareNewsWhatsApp(item) {
        const talukaObj = (window.KOLHAPUR_TALUKAS || []).find(t => t.id === item.taluka);
        const talukaLabel = talukaObj ? talukaObj.name_mr : item.taluka;

        const shareText = `*✅ कोल्हापूर जिल्हा अधिकृत पडताळणी झालेले वृत्त*
📍 *तालुका:* ${talukaLabel} (${item.rural_area || ''})
📰 *शीर्षक:* ${item.title_mr}
📝 *सारांश:* ${item.summary_mr}
🏛️ *अधिकृत स्त्रोत:* ${item.source_name}
📅 *दिनांक व वेळ:* ${item.date_mr} • ${item.time_str || ''}
🛡️ *सत्यता दर्जा:* १००% अधिकृत व पडताळणी केलेले

_नागरिकांनी कोणत्याही असत्यापित अफवांवर विश्वास ठेवू नका. कोल्हापूर जिल्हा सत्य पडताळणी मंचाचा अधिकृत संदेश._
👉 ${window.location.href.split('?')[0].split('#')[0]}`;

        const encoded = encodeURIComponent(shareText);
        window.open(`https://api.whatsapp.com/send?text=${encoded}`, '_blank');
    }

    // Fetch Fact-Checks
    function loadFactChecks() {
        if (window.EMBEDDED_DATA) {
            const data = getLocalFactChecks(state.taluka, state.search);
            state.factChecks = data.fact_checks;
            elements.statFactCount.textContent = data.fact_checks.length;
            elements.factCountBadge.textContent = `${data.fact_checks.length} दावे`;
            renderFactChecks();
            return;
        }

        const url = `/api/fact-checks?taluka=${encodeURIComponent(state.taluka)}&search=${encodeURIComponent(state.search)}&date=${encodeURIComponent(state.date)}`;

        fetch(url)
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    state.factChecks = data.fact_checks;
                    elements.statFactCount.textContent = data.fact_checks.length;
                    elements.factCountBadge.textContent = `${data.fact_checks.length} दावे`;
                    renderFactChecks();
                }
            })
            .catch(err => {
                console.error('Error fetching fact-checks:', err);
                if (window.EMBEDDED_DATA) {
                    const data = getLocalFactChecks(state.taluka, state.search);
                    state.factChecks = data.fact_checks;
                    elements.statFactCount.textContent = data.fact_checks.length;
                    elements.factCountBadge.textContent = `${data.fact_checks.length} दावे`;
                    renderFactChecks();
                }
            });
    }

    // Render Fact-Check Cards
    function renderFactChecks() {
        if (!state.factChecks || state.factChecks.length === 0) {
            elements.factCheckList.innerHTML = `
                <div style="text-align: center; padding: 40px; background: #fff; border-radius: 10px;">
                    <p style="color: var(--text-muted);">कोणताही व्हायरल दावा उपलब्ध नाही.</p>
                </div>
            `;
            return;
        }

        elements.factCheckList.innerHTML = '';
        state.factChecks.forEach(fc => {
            const card = document.createElement('div');
            card.className = 'factcheck-card';

            const talukaObj = (window.KOLHAPUR_TALUKAS || []).find(t => t.id === fc.taluka);
            const talukaLabel = talukaObj ? talukaObj.name_mr : fc.taluka;

            const isMr = state.lang === 'mr';
            const claim = isMr ? fc.claim_mr : (fc.claim_en || fc.claim_mr);
            const reality = isMr ? fc.reality_mr : (fc.reality_en || fc.reality_mr);

            card.innerHTML = `
                <div class="fc-card-header">
                    <span class="fc-verdict-pill ${fc.verdict_color || 'danger'}">
                        <i class="fa-solid ${fc.verdict === 'FALSE' ? 'fa-circle-xmark' : (fc.verdict === 'PARTIALLY_TRUE' ? 'fa-triangle-exclamation' : 'fa-circle-check')}"></i>
                        ${fc.verdict_badge}
                    </span>
                    <div class="fc-meta">
                        <span><i class="fa-solid fa-location-dot"></i> ${talukaLabel}</span> •
                        <span><i class="fa-regular fa-clock"></i> ${fc.time_str || ''}</span>
                    </div>
                </div>
                <div class="fc-body">
                    <div class="fc-claim-box">
                        <div class="claim-tag"><i class="fa-solid fa-share-nodes"></i> सोशल मीडियावरील व्हायरल दावा:</div>
                        <div class="claim-quote">"${claim}"</div>
                        <div class="fc-medium-tag"><i class="fa-brands fa-whatsapp"></i> व्हायरल माध्यम: ${fc.viral_medium || 'WhatsApp'}</div>
                    </div>
                    <div class="fc-reality-box">
                        <div class="reality-tag"><i class="fa-solid fa-shield-check"></i> वस्तुस्थिती / सत्य काय आहे? (Reality Check):</div>
                        <div class="reality-text">${reality}</div>
                    </div>
                    <div class="fc-evidence-box">
                        <div class="evidence-info">
                            <strong><i class="fa-solid fa-file-circle-check"></i> शासकीय पुरावा व संदर्भ:</strong> ${fc.official_evidence}<br>
                            <small style="color: var(--text-muted);"><i class="fa-solid fa-user-check"></i> पडताळणी कक्ष: ${fc.checked_by} (${fc.evidence_doc || ''})</small>
                        </div>
                        <button class="btn-share-fact" data-id="${fc.id}">
                            <i class="fa-brands fa-whatsapp"></i> सत्य शेअर करा
                        </button>
                    </div>
                </div>
            `;

            card.querySelector('.btn-share-fact').addEventListener('click', () => shareFactCheckWhatsApp(fc));
            elements.factCheckList.appendChild(card);
        });
    }

    function shareFactCheckWhatsApp(fc) {
        const shareText = `*🔍 कोल्हापूर फॅक्ट-चेक निकाल: ${fc.verdict_badge}*
❌ *व्हायरल दावा:* ${fc.claim_mr}
✅ *खरी वस्तुस्थिती:* ${fc.reality_mr}
🏛️ *अधिकृत शासकीय पुरावा:* ${fc.official_evidence}
👨‍💼 *पडताळणी कक्ष:* ${fc.checked_by}

_अफवा रोखा, सत्य पसरवा! संपूर्ण माहितीसाठी भेट द्या:_
👉 ${window.location.href.split('?')[0].split('#')[0]}`;

        const encoded = encodeURIComponent(shareText);
        window.open(`https://api.whatsapp.com/send?text=${encoded}`, '_blank');
    }

    // Fetch Emergency Alerts
    function loadAlerts() {
        if (window.EMBEDDED_DATA) {
            const data = getLocalAlerts();
            state.alerts = data.alerts;
            renderAlerts();
            return;
        }

        fetch('/api/alerts')
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    state.alerts = data.alerts;
                    renderAlerts();
                }
            })
            .catch(err => {
                console.error('Error fetching alerts:', err);
                if (window.EMBEDDED_DATA) {
                    const data = getLocalAlerts();
                    state.alerts = data.alerts;
                    renderAlerts();
                }
            });
    }

    function renderAlerts() {
        if (!state.alerts || state.alerts.length === 0) return;
        elements.alertsCardsList.innerHTML = '';
        state.alerts.forEach(al => {
            const item = document.createElement('div');
            const alertClass = al.level === 'WARNING' ? 'warning' : (al.level === 'DANGER' ? 'danger' : 'info');
            item.className = `alert-banner-item ${alertClass}`;

            item.innerHTML = `
                <div class="alert-head-row">
                    <span class="alert-badge-pill"><i class="fa-solid fa-bell"></i> ${al.badge} (${al.level_mr})</span>
                    <span class="alert-time"><i class="fa-regular fa-clock"></i> ${al.time}</span>
                </div>
                <h4 class="alert-title">${al.title_mr}</h4>
                <p class="alert-desc">${al.details_mr}</p>
                <div class="alert-auth">
                    <i class="fa-solid fa-landmark"></i> अधिकृत प्राधिकरण: ${al.authority} | ${al.contact}
                </div>
            `;
            elements.alertsCardsList.appendChild(item);
        });
    }

    // Handle Citizen Fake News Report Submission
    function handleCitizenReportSubmit(e) {
        e.preventDefault();
        elements.btnSubmitReport.disabled = true;
        elements.btnSubmitReport.innerHTML = `<i class="fa-solid fa-circle-notch fa-spin"></i> नोंदणी सुरू आहे...`;

        const payload = {
            name: document.getElementById('reporterName').value.trim(),
            contact: document.getElementById('reporterContact').value.trim(),
            taluka: document.getElementById('reporterTaluka').value,
            area: document.getElementById('reporterArea').value.trim(),
            source_medium: document.getElementById('reporterSource').value,
            claim_text: document.getElementById('reporterClaim').value.trim()
        };

        fetch('/api/report-fake', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
            .then(res => res.json())
            .then(data => {
                elements.btnSubmitReport.disabled = false;
                elements.btnSubmitReport.innerHTML = `<i class="fa-solid fa-paper-plane"></i> फॅक्ट-चेक पडताळणीसाठी सादर करा`;

                if (data.success) {
                    elements.reportFormMessage.innerHTML = `<span style="color: var(--success);"><i class="fa-solid fa-circle-check"></i> ${data.message} (तक्रार क्र.: ${data.report.id})</span>`;
                    elements.citizenReportForm.reset();
                    setTimeout(() => { elements.reportFormMessage.innerHTML = ''; }, 6000);
                } else {
                    elements.reportFormMessage.innerHTML = `<span style="color: var(--danger);">${data.error || 'त्रुटी आढळली.'}</span>`;
                }
            })
            .catch(err => {
                elements.btnSubmitReport.disabled = false;
                elements.btnSubmitReport.innerHTML = `<i class="fa-solid fa-paper-plane"></i> फॅक्ट-चेक पडताळणीसाठी सादर करा`;
                elements.reportFormMessage.innerHTML = `<span style="color: var(--danger);">सर्व्हरशी संपर्क साधता आला नाही.</span>`;
            });
    }

    // Load Admin Reports
    function loadAdminReports() {
        elements.adminReportsTableBody.innerHTML = `<tr><td colspan="6" class="text-center"><i class="fa-solid fa-circle-notch fa-spin"></i> तक्रारी लोड होत आहेत...</td></tr>`;

        fetch('/api/admin/reports')
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    renderAdminReports(data.reports);
                }
            })
            .catch(err => {
                elements.adminReportsTableBody.innerHTML = `<tr><td colspan="6" class="text-center" style="color: red;">तक्रारी लोड करताना त्रुटी.</td></tr>`;
            });
    }

    function renderAdminReports(reports) {
        if (!reports || reports.length === 0) {
            elements.adminReportsTableBody.innerHTML = `<tr><td colspan="6" class="text-center" style="padding: 24px; color: var(--text-muted);">सध्या कोणतीही नागरिक तक्रार प्रलंबित नाही.</td></tr>`;
            return;
        }

        elements.adminReportsTableBody.innerHTML = '';
        reports.forEach(rep => {
            const tr = document.createElement('tr');
            const talukaObj = (window.KOLHAPUR_TALUKAS || []).find(t => t.id === rep.taluka);
            const talukaLabel = talukaObj ? talukaObj.name_mr : rep.taluka;

            let statusHtml = `<span class="status-tag-pending"><i class="fa-regular fa-clock"></i> प्रलंबित (Pending)</span>`;
            if (rep.status === 'VERIFIED') statusHtml = `<span class="status-tag-verified"><i class="fa-solid fa-circle-check"></i> सत्यापित सत्य</span>`;
            if (rep.status === 'DEBUNKED') statusHtml = `<span class="status-tag-debunked"><i class="fa-solid fa-circle-xmark"></i> खोटी बातमी (Debunked)</span>`;

            tr.innerHTML = `
                <td><strong>${rep.submitted_at || '-'}</strong></td>
                <td><i class="fa-solid fa-location-dot" style="color: #dc2626;"></i> ${talukaLabel}<br><small style="color: #64748b;">${rep.area || ''}</small></td>
                <td style="max-width: 280px; font-weight: 500;">"${rep.claim_text}"</td>
                <td><small>${rep.source_medium || 'WhatsApp'}</small></td>
                <td>${statusHtml}</td>
                <td>
                    <div class="action-btns-group">
                        <button class="btn-act-verify" data-id="${rep.id}"><i class="fa-solid fa-check"></i> सत्य</button>
                        <button class="btn-act-debunk" data-id="${rep.id}"><i class="fa-solid fa-ban"></i> फेक</button>
                    </div>
                </td>
            `;

            tr.querySelector('.btn-act-verify').addEventListener('click', () => updateReportStatus(rep.id, 'VERIFIED'));
            tr.querySelector('.btn-act-debunk').addEventListener('click', () => updateReportStatus(rep.id, 'DEBUNKED'));

            elements.adminReportsTableBody.appendChild(tr);
        });
    }

    function updateReportStatus(id, newStatus) {
        fetch('/api/admin/verify-report', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ report_id: id, status: newStatus, notes: 'प्रशासकीय पडताळणी पूर्ण' })
        })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    loadAdminReports();
                }
            });
    }

    // Admin Publish New News
    function handleAdminAddNewsSubmit(e) {
        e.preventDefault();
        const payload = {
            taluka: document.getElementById('adminNewsTaluka').value,
            rural_area: document.getElementById('adminNewsRural').value.trim(),
            category: document.getElementById('adminNewsCategory').value,
            source_name: document.getElementById('adminNewsSource').value.trim(),
            title_mr: document.getElementById('adminNewsTitleMr').value.trim(),
            summary_mr: document.getElementById('adminNewsSummaryMr').value.trim(),
            content_mr: document.getElementById('adminNewsContentMr').value.trim()
        };

        fetch('/api/admin/add-news', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    elements.adminAddNewsMessage.innerHTML = `<span style="color: var(--success);"><i class="fa-solid fa-circle-check"></i> बातमी यशस्वीरित्या प्रसिद्ध झाली!</span>`;
                    elements.adminAddNewsForm.reset();
                    setTimeout(() => {
                        elements.addNewsModal.classList.add('hidden');
                        elements.adminAddNewsMessage.innerHTML = '';
                        loadNews();
                    }, 1200);
                } else {
                    elements.adminAddNewsMessage.innerHTML = `<span style="color: var(--danger);">${data.error}</span>`;
                }
            });
    }

    // Run on DOM Ready
    document.addEventListener('DOMContentLoaded', init);

})();

    </script>

