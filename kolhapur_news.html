            const title = isMr ? item.title_mr : (item.title_en || item.title_mr);
            const summary = isMr ? item.summary_mr : (item.summary_en || item.summary_mr);
            const dateStr = isMr ? item.date_mr : item.date_en;

            card.innerHTML = `
                <div style="position: relative;">
                    <img class="news-card-image" src="${item.image || 'https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?w=600'}" alt="${title}" loading="lazy">
                    <div class="card-top-badges">
                        <span class="badge-verified"><i class="fa-solid fa-circle-check"></i> ${item.badge_text || 'अधिकृत पडताळणी'}</span>
                        <span class="badge-taluka"><i class="fa-solid fa-location-dot"></i> ${talukaLabel}</span>
                    </div>
                </div>
                <div class="news-card-body">
                    <div class="card-meta-row">
                        <span><i class="fa-regular fa-calendar"></i> ${dateStr}</span>
                        <span><i class="fa-regular fa-clock"></i> ${item.time_str || ''}</span>
                    </div>
                    <div style="font-size: 12px; font-weight: 700; color: #2563eb; margin-bottom: 4px;">
                        <i class="fa-solid fa-tag"></i> ${item.category} • ${item.rural_area || ''}
                    </div>
                    <h3 class="news-card-title">${title}</h3>
                    <p class="news-card-summary">${summary}</p>
                    <div class="news-card-source">
                        <div class="source-head"><i class="fa-solid fa-shield"></i> अधिकृत स्त्रोत (Verified Source):</div>
