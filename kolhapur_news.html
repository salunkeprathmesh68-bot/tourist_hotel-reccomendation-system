    // Standalone / Offline Embedded Data Engine
    function getLocalNews(taluka, category, search, dateStr) {
        if (!window.EMBEDDED_DATA) return { success: false, news: [] };

        let dt = new Date();
        if (dateStr) {
            const parts = dateStr.split('-');
            if (parts.length === 3) {
                dt = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
            }
        }

        const weekday = dt.getDay(); // 0 is Sun, 1 is Mon...
        const pyWeekday = weekday === 0 ? 6 : weekday - 1;

        let newsPool = (window.EMBEDDED_DATA.day_news && window.EMBEDDED_DATA.day_news[String(pyWeekday)])
            ? [...window.EMBEDDED_DATA.day_news[String(pyWeekday)]]
            : [...(window.EMBEDDED_DATA.base_news || [])];

        try {
            const custom = JSON.parse(localStorage.getItem('kolhapur_custom_news') || '[]');
            newsPool = [...custom, ...newsPool];
        } catch (e) {}

        const daysMr = ["रविवार", "सोमवार", "मंगळवार", "बुधवार", "गुरुवार", "शुक्रवार", "शनिवार"];
        const monthsMr = ["जानेवारी", "फेब्रुवारी", "मार्च", "एप्रिल", "मे", "जून", "जुलै", "ऑगस्ट", "सप्टेंबर", "ऑक्टोबर", "नोव्हेंबर", "डिसेंबर"];
        const marathiDigits = str => String(str).replace(/\d/g, d => "०१२३४५६७८९"[d]);

        const dayNameMr = daysMr[dt.getDay()];
        const monthNameMr = monthsMr[dt.getMonth()];
        const dayNumMr = marathiDigits(String(dt.getDate()).padStart(2, '0'));
        const yearNumMr = marathiDigits(String(dt.getFullYear()));
        const dateMr = `${dayNameMr}, ${dayNumMr} ${monthNameMr} ${yearNumMr}`;
        const dateEn = dt.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

        let filtered = newsPool.filter(item => {
            if (taluka !== 'all' && item.taluka && item.taluka.toLowerCase() !== taluka.toLowerCase()) return false;
            if (category !== 'all' && item.category && item.category.toLowerCase() !== category.toLowerCase()) return false;
            if (search) {
                const corpus = `${item.title_mr || ''} ${item.title_en || ''} ${item.summary_mr || ''} ${item.rural_area || ''} ${item.taluka || ''}`.toLowerCase();
                if (!corpus.includes(search.toLowerCase())) return false;
            }
            return true;
        }).map(item => ({
            ...item,
            date_mr: dateMr,
            date_en: dateEn,
            day_mr: dayNameMr,
            day_en: dt.toLocaleDateString('en-US', { weekday: 'long' })
        }));

        return { success: true, count: filtered.length, news: filtered };
    }

    function getLocalFactChecks(taluka, search) {
        if (!window.EMBEDDED_DATA || !window.EMBEDDED_DATA.fact_checks) return { success: false, fact_checks: [] };
        let checks = window.EMBEDDED_DATA.fact_checks.filter(fc => {
            if (taluka !== 'all' && fc.taluka && fc.taluka.toLowerCase() !== taluka.toLowerCase()) return false;
            if (search) {
                const corpus = `${fc.claim_mr || ''} ${fc.reality_mr || ''}`.toLowerCase();
                if (!corpus.includes(search.toLowerCase())) return false;
            }
            return true;
        });
        return { success: true, count: checks.length, fact_checks: checks };
    }

    function getLocalAlerts() {
        if (!window.EMBEDDED_DATA || !window.EMBEDDED_DATA.alerts) return { success: false, alerts: [] };
        return { success: true, alerts: window.EMBEDDED_DATA.alerts };
    }

    // Fetch News from Backend or Embedded Data
    function loadNews() {
        if (window.EMBEDDED_DATA) {
            const data = getLocalNews(state.taluka, state.category, state.search, state.date);
            state.news = data.news;
            elements.statNewsCount.textContent = data.news.length;
            renderNewsGrid();
            return;
        }

        elements.newsCardsGrid.innerHTML = `
            <div class="loading-state" style="grid-column: 1 / -1; text-align: center; padding: 40px; color: var(--text-muted);">
                <i class="fa-solid fa-circle-notch fa-spin fa-2x"></i>
                <p style="margin-top: 10px;">पडताळणी झालेल्या बातम्या लोड होत आहेत...</p>
            </div>
        `;

        const url = `/api/news?taluka=${encodeURIComponent(state.taluka)}&category=${encodeURIComponent(state.category)}&search=${encodeURIComponent(state.search)}&date=${encodeURIComponent(state.date)}`;

        fetch(url)
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    state.news = data.news;
                    elements.statNewsCount.textContent = data.news.length;
                    renderNewsGrid();
                }
            })
            .catch(err => {
                console.error('Error fetching news:', err);
                if (window.EMBEDDED_DATA) {
                    const data = getLocalNews(state.taluka, state.category, state.search, state.date);
                    state.news = data.news;
                    elements.statNewsCount.textContent = data.news.length;
                    renderNewsGrid();
                } else {
                    elements.newsCardsGrid.innerHTML = `<div style="grid-column: 1 / -1; text-align: center; color: red;">बातम्या लोड करण्यात अडचण आली. कृपया पुन्हा प्रयत्न करा.</div>`;
                }
            });
    }

