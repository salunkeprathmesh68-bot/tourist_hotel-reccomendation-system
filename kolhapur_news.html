    // Initialize
    function init() {
        bindEvents();
        loadNews();
        loadFactChecks();
        loadAlerts();
        updateRuralCoverageDisplay();
    }

    // Event Bindings
    function bindEvents() {
        // Tab switching
        elements.tabBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const targetTab = btn.getAttribute('data-tab');
                elements.tabBtns.forEach(b => b.classList.remove('active'));
                elements.tabPanes.forEach(p => p.classList.remove('active'));
                btn.classList.add('active');
                const targetPane = document.getElementById(targetTab);
                if (targetPane) targetPane.classList.add('active');

                if (targetTab === 'tab-admin') {
                    loadAdminReports();
                }
            });
        });

        // Quick Day Switchers (काल, आज, उद्या)
        const formatIsoDate = (d) => d.toISOString().split('T')[0];

        function setEditionDate(dateStr, subtagText) {
            state.date = dateStr;
            if (elements.editionDatePicker) elements.editionDatePicker.value = dateStr;
            updateDateDisplay(dateStr, subtagText);
            loadNews();
            loadFactChecks();
        }

        if (elements.btnQuickToday) {
            elements.btnQuickToday.addEventListener('click', () => {
                const today = new Date();
                elements.btnQuickYesterday.classList.remove('active');
                elements.btnQuickTomorrow.classList.remove('active');
                elements.btnQuickToday.classList.add('active');
                setEditionDate(formatIsoDate(today), 'आजच्या ताज्या घडामोडी');
            });
        }

        if (elements.btnQuickYesterday) {
            elements.btnQuickYesterday.addEventListener('click', () => {
                const yest = new Date();
                yest.setDate(yest.getDate() - 1);
                elements.btnQuickToday.classList.remove('active');
                elements.btnQuickTomorrow.classList.remove('active');
                elements.btnQuickYesterday.classList.add('active');
                setEditionDate(formatIsoDate(yest), 'कालच्या घडामोडी');
            });
        }

        if (elements.btnQuickTomorrow) {
            elements.btnQuickTomorrow.addEventListener('click', () => {
                const tomo = new Date();
                tomo.setDate(tomo.getDate() + 1);
                elements.btnQuickToday.classList.remove('active');
                elements.btnQuickYesterday.classList.remove('active');
                elements.btnQuickTomorrow.classList.add('active');
                setEditionDate(formatIsoDate(tomo), 'उद्याच्या ताज्या घडामोडी');
            });
        }

        // Date Drawer Toggle
        elements.btnChangeDate.addEventListener('click', () => {
            elements.dateDrawer.classList.toggle('hidden');
        });
        elements.btnCloseDrawer.addEventListener('click', () => {
            elements.dateDrawer.classList.add('hidden');
        });
        elements.btnApplyDate.addEventListener('click', () => {
            const selected = elements.editionDatePicker.value;
            if (selected) {
                elements.btnQuickToday.classList.remove('active');
                elements.btnQuickYesterday.classList.remove('active');
                elements.btnQuickTomorrow.classList.remove('active');
                elements.dateDrawer.classList.add('hidden');
                setEditionDate(selected, 'निवडलेल्या तारखेची आवृत्ती');
            }
        });
        elements.btnResetToday.addEventListener('click', () => {
            const todayStr = formatIsoDate(new Date());
            elements.btnQuickToday.classList.add('active');
            elements.btnQuickYesterday.classList.remove('active');
            elements.btnQuickTomorrow.classList.remove('active');
            elements.dateDrawer.classList.add('hidden');
            setEditionDate(todayStr, 'आजच्या ताज्या घडामोडी');
        });

        // Language Toggle
        elements.btnToggleLang.addEventListener('click', toggleLanguage);

        // Taluka Pills
        elements.talukaPillsRow.querySelectorAll('.taluka-pill').forEach(pill => {
            pill.addEventListener('click', () => {
                elements.talukaPillsRow.querySelectorAll('.taluka-pill').forEach(p => p.classList.remove('active'));
                pill.classList.add('active');
                state.taluka = pill.getAttribute('data-taluka');
                updateActiveTalukaHeader(pill);
                updateRuralCoverageDisplay();
                loadNews();
                loadFactChecks();
            });
        });

        // Search Input (Debounced)
        let debounceTimer;
        elements.newsSearchInput.addEventListener('input', (e) => {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                state.search = e.target.value.trim();
                loadNews();
                loadFactChecks();
            }, 300);
        });

        // Category Filter Buttons
        elements.categoryButtons.querySelectorAll('.cat-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                elements.categoryButtons.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                state.category = btn.getAttribute('data-category');
                loadNews();
            });
        });

        // News Modal Close
        elements.btnCloseNewsModal.addEventListener('click', closeNewsModal);
        elements.newsModal.addEventListener('click', (e) => {
            if (e.target === elements.newsModal) closeNewsModal();
        });

        // Modal TTS
        elements.btnModalTTS.addEventListener('click', toggleSpeech);

        // Modal WhatsApp Share
        elements.btnModalShareWhatsApp.addEventListener('click', () => {
            if (state.activeNewsItem) {
                shareNewsWhatsApp(state.activeNewsItem);
            }
        });

        // Citizen Report Form Submit
        elements.citizenReportForm.addEventListener('submit', handleCitizenReportSubmit);

        // Admin Desk Refresh & Add News
        elements.btnRefreshAdminReports.addEventListener('click', loadAdminReports);
        elements.btnOpenAddNewsModal.addEventListener('click', () => {
            elements.addNewsModal.classList.remove('hidden');
        });
        elements.btnCloseAddNewsModal.addEventListener('click', () => {
            elements.addNewsModal.classList.add('hidden');
        });
        elements.addNewsModal.addEventListener('click', (e) => {
            if (e.target === elements.addNewsModal) elements.addNewsModal.classList.add('hidden');
        });
        elements.adminAddNewsForm.addEventListener('submit', handleAdminAddNewsSubmit);
    }

    // Toggle Marathi / English
    function toggleLanguage() {
        state.lang = state.lang === 'mr' ? 'en' : 'mr';
        elements.langLabel.textContent = state.lang === 'mr' ? 'English' : 'मराठी';
        renderNewsGrid();
        renderFactChecks();
    }

    // Update Date Display in Header
    function updateDateDisplay(dateStr, subtagText = 'आजच्या ताज्या घडामोडी') {
        let d = new Date();
        if (dateStr) {
            const parts = dateStr.split('-');
            if (parts.length === 3) {
                d = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
            }
        }
        const daysMr = ["रविवार", "सोमवार", "मंगळवार", "बुधवार", "गुरुवार", "शुक्रवार", "शनिवार"];
        const monthsMr = ["जानेवारी", "फेब्रुवारी", "मार्च", "एप्रिल", "मे", "जून", "जुलै", "ऑगस्ट", "सप्टेंबर", "ऑक्टोबर", "नोव्हेंबर", "डिसेंबर"];
        const marathiDigits = str => str.replace(/\d/g, d => "०१२३४५६७८९"[d]);

        const dayNameMr = daysMr[d.getDay()];
        const monthNameMr = monthsMr[d.getMonth()];
        const dayNumMr = marathiDigits(String(d.getDate()).padStart(2, '0'));
        const yearNumMr = marathiDigits(String(d.getFullYear()));

        const mrFormatted = `${dayNameMr}, ${dayNumMr} ${monthNameMr} ${yearNumMr}`;
        elements.currentDateMr.textContent = mrFormatted;
        elements.currentDateEn.textContent = d.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

        if (elements.editionCurrentText) {
            elements.editionCurrentText.innerHTML = `<strong>${mrFormatted}</strong> — <span class="edition-subtag">${subtagText}</span>`;
        }
    }

